<?xml version="1.0" encoding="UTF-8"?>
<!--
  AgentHub 日志：控制台 + 按天（兼大小）滚动文件。
  级别仍由 application.yml 的 logging.level.* 控制，本文件不把全站改成 DEBUG。
  路径相对进程工作目录，禁止写死盘符；多实例各自写各自目录，不做集中锁。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 当前日志文件；可用 logging.file.name 覆盖 -->
    <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="logs/agenthub.log"/>
    <!-- 保留天数；对应 logging.logback.rollingpolicy.max-history -->
    <springProperty name="LOG_MAX_HISTORY" source="logging.logback.rollingpolicy.max-history" defaultValue="30"/>
    <!-- 归档总上限；对应 logging.logback.rollingpolicy.total-size-cap -->
    <springProperty name="LOG_TOTAL_SIZE_CAP" source="logging.logback.rollingpolicy.total-size-cap" defaultValue="3GB"/>
    <!-- 单文件上限（同日按大小再切）；对应 logging.logback.rollingpolicy.max-file-size -->
    <springProperty name="LOG_MAX_FILE_SIZE" source="logging.logback.rollingpolicy.max-file-size" defaultValue="100MB"/>

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 文件：当前 logs/agenthub.log；归档含日期，可选 gz -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 一天一文件；同日过大再按 %i 切；gz 压缩归档 -->
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 根级别 INFO；业务包级别由 yml logging.level 叠加，此处不改策略 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
