# 本机 jar 直跑时的可选配置模板。所属域：运维配置，不是业务代码。
#
# 用法（二选一，不要写进 src/main/resources）：
# 1) 本机 jar：复制为 AgentHub-server/config/application-local.yml（该目录不入库、也不打进 jar）
# 2) Docker Compose：优先用仓库根目录 .env 注入；一般不必准备本文件。
#    若仍要文件覆盖，把填好的副本放到 secrets/application-local.yml，
#    并在 docker-compose.yml 的 server.volumes 取消对应挂载注释（缺文件时不要挂，否则起不来）。
#
# 为什么不在 src/main/resources：那份目录会整体打进 jar 与 Docker 镜像，
# 一旦把主密钥和库密码写进去，等于随制品一起分发。
#
# Compose 容器内数据源用户名已被环境变量固定为 agenthub，口令来自 MYSQL_PASSWORD；
# 本机直连本机 MySQL 时才需要下面的 username/password（常见为 root 或本地账号）。
spring:
  datasource:
    username: root
    password: 请替换为本地密码

agenthub:
  workspace:
    # 会话级文件工具的落盘根目录（workspaceWriteFile 等三个工具共用），每会话在其下建一级子目录。
    # 默认已在 application.yml 配成 ./workspace-test（已 gitignore），此处一般不写；
    # 想换目录再覆盖，写成绝对路径可避开「相对进程工作目录」的歧义。
    # root-path: ./workspace-test
  crypto:
    # openssl rand -hex 32 的结果。这是主密钥，不是厂商 sk。
    # Compose 下一键路径用 .env 的 AGENTHUB_SECRET_KEY，不必写在这里。
    secret-key: 请替换为 64 位 hex
    # 主密钥轮换过渡期使用：旧密钥填这里，只解密不加密。
    # 启动后迁移任务会把旧密文重写成新密钥，完成后清空此项即可。
    # previous-keys: 旧密钥1,旧密钥2
