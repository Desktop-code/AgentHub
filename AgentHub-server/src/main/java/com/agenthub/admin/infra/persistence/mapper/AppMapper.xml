<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agenthub.admin.infra.persistence.mapper.AppMapper">

    <select id="selectPageByScope" resultType="com.agenthub.admin.infra.persistence.entity.SysAppEntity">
        SELECT a.id, a.app_key, a.name, a.dept_id, a.status, a.remark, a.create_time, a.created_by,
               d.name AS dept_name
        FROM sys_app a
        LEFT JOIN sys_dept d ON d.id = a.dept_id AND d.deleted = 0
        WHERE a.deleted = 0
        <if test="name != null and name != ''">
            AND a.name LIKE CONCAT('%', #{name}, '%') ESCAPE '\\'
        </if>
        <if test="status != null">
            AND a.status = #{status}
        </if>
        <if test="scope != null and scope.unrestricted == false">
            AND (
                1 = 0
                <if test="scope.includeSelf">
                    OR a.created_by = #{scope.selfUserId}
                </if>
                <if test="scope.deptIds != null and scope.deptIds.size() > 0">
                    OR a.dept_id IN
                    <foreach collection="scope.deptIds" item="id" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </if>
                <if test="scope.pathPrefixes != null and scope.pathPrefixes.size() > 0">
                    <foreach collection="scope.pathPrefixes" item="prefix">
                        <!-- 部门 path 是 0,1,3 逗号串：等于前缀或以「前缀+逗号」开头才算下级 -->
                        OR d.path = #{prefix} OR d.path LIKE CONCAT(#{prefix}, ',%')
                    </foreach>
                </if>
            )
        </if>
        ORDER BY a.id DESC
    </select>

    <select id="countByAppKey" resultType="long">
        SELECT COUNT(1) FROM sys_app WHERE app_key = #{appKey}
    </select>
</mapper>
