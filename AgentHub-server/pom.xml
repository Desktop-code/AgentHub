<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.agenthub</groupId>
    <artifactId>agenthub-server</artifactId>
    <version>0.1.0</version>
    <name>AgentHub-server</name>
    <description>AgentHub 基座：控制台鉴权、薄 RBAC 与审计</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <sa-token.version>1.39.0</sa-token.version>
        <springdoc.version>2.3.0</springdoc.version>
        <!-- 试跑默认引擎。勿改成 Spring AI Alibaba，也不要为此拆 module。 -->
        <agentscope.version>2.0.4</agentscope.version>
        <!-- RAG 本地向量库。版本钉死：SDK 小版本间 API 有差异（如 addField / Function 构建方式） -->
        <milvus.sdk.version>2.6.17</milvus.sdk.version>
        <!-- RAG 入库 PDF 解析。2.0.x 的 PDDocument.load 与 3.x 不兼容，勿随手升级 -->
        <pdfbox.version>2.0.30</pdfbox.version>
        <!-- RAG 入库 DOCX：标题样式 → Markdown #，与 mall 本地解析对齐 -->
        <poi.version>5.2.5</poi.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB：MyBatis-Plus，不引入 JPA -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9 起分页拦截器拆到独立包 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 短期记忆与对话窗口。Sa-Token 仍用单机会话，不切到 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 提示词 L1/L2 进程内缓存（Caffeine → Redis → DB 的第一层）。
             版本由 Spring Boot 管理；Redis 抖动时降级到 DB，不阻塞启动。 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 模型出站 ACL 的流式 HTTP 客户端：WebClient 在 spring-webflux 里，
             应用仍是 spring-boot-starter-web 的 Servlet 容器（不引 starter-webflux，避免多一套 Web 栈）。
             流式解析只用 Reactor；不引入任何厂商 SDK。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>

        <!-- 鉴权：仅 Sa-Token，不引入 spring-boot-starter-security -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 只使用 BCrypt 算法，不装配 Security 过滤器链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- AgentScope：ReAct 与模型客户端。Router 在本服务内做一层分发，子 Agent 仍走 ReActAgent。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- 工具与文档 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- RAG 本地向量库客户端。仅 rag 域使用；BM25 由 Milvus 服务端 Sparse + Function 提供，
             不引入向量检索/BM25 的第三方库。 -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>${milvus.sdk.version}</version>
        </dependency>

        <!-- RAG 入库解析：PDF 文字层抽取。扫描件 OCR / MinerU 为可选，默认关、无 Key 不炸。
             版本与 Spring Boot 3.2 兼容；PDFBox 2.x 的 PDDocument.load(InputStream) 在 3.x 已改名。 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- RAG 入库 DOCX（POI）；只引 ooxml，不引整套 office 栈 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 浏览器组件 -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.40.0</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>agenthub-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 本机密钥与密码只从外部提供：绝不打进 jar / 镜像。
                     模板文件无真实密钥，允许随产物分发作为运维参考。 -->
                <excludes>
                    <exclude>application-local.yml</exclude>
                </excludes>
            </resource>
            <!-- Mapper XML 与接口放在同一 Java 包，需单独纳入 classpath -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 打包防回退：application-local.yml 里有主密钥与库密码，一旦被打进 target/classes
                 就等于随 jar / 镜像一起分发出去。此规则在 verify 阶段检查产物目录，命中即构建失败。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>forbid-local-secrets-in-artifact</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesDontExist>
                                    <message>
                                        application-local.yml 不得进入构建产物：它含主密钥与数据库密码。
                                        本机配置请放到 AgentHub-server/config/（不入库），或用环境变量注入。
                                    </message>
                                    <files>
                                        <file>${project.build.outputDirectory}/application-local.yml</file>
                                    </files>
                                </requireFilesDontExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
