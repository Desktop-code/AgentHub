  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "页面唯一主操作：新建、保存、发送。紫底白字，32px 高。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">保存</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 14px;border:0;border-radius:8px;background:var(--ah-primary,#635bff);color:#fff;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:14px;font-weight:400;line-height:1;cursor:pointer;transition:background-color .15s ease,box-shadow .15s ease}.ds-btn-primary:hover{background:var(--ah-primary-hover,#5146f5)}.ds-btn-primary:active{background:var(--ah-primary-active,#4338ca)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(99,91,255,.2)}"
    },
    {
      "name": "Reset Button",
      "kind": "button",
      "refersTo": "button-reset",
      "description": "白底描边的次级操作：重置、取消。与主按钮同高同圆角。",
      "html": "<button class=\"ds-btn-reset\" type=\"button\">重置</button>",
      "css": ".ds-btn-reset{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 14px;border:1px solid var(--ah-border,#ebeef5);border-radius:8px;background:#fff;color:var(--ah-text,#1f2937);font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:14px;line-height:1;cursor:pointer;transition:background-color .15s ease,border-color .15s ease}.ds-btn-reset:hover{background:#f5f7fa;border-color:#c0c4cc}.ds-btn-reset:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(99,91,255,.2)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "筛选与表单输入：浅灰填充、无描边，聚焦转白加紫光。",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">关键词</span><input class=\"ds-input\" placeholder=\"搜索名称或编码\" /></label>",
      "css": ".ds-field{display:flex;align-items:center;gap:8px;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif}.ds-field-label{font-size:13px;color:#374151;white-space:nowrap}.ds-input{width:220px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:8px;background:var(--ah-input-fill,#f5f7fa);color:var(--ah-text,#1f2937);font-family:inherit;font-size:14px;box-sizing:border-box;transition:background-color .15s ease,border-color .15s ease,box-shadow .15s ease}.ds-input::placeholder{color:#9ca3af}.ds-input:focus{outline:none;background:#fff;border-color:var(--ah-primary,#635bff);box-shadow:0 0 0 2px rgba(99,91,255,.2)}"
    },
    {
      "name": "Sidebar Nav Item",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "40px 高导航项；当前项紫底白字，hover 浅灰底。",
      "html": "<nav class=\"ds-nav-list\"><a class=\"ds-nav is-current\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"3\"/><path d=\"M5 8h6\"/></svg><span>对话</span></a><a class=\"ds-nav\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M2 5h12M2 8h12M2 11h8\"/></svg><span>模型管理</span></a></nav>",
      "css": ".ds-nav-list{display:flex;flex-direction:column;gap:2px;padding:12px;background:#fff;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif}.ds-nav{display:flex;align-items:center;gap:10px;height:40px;padding:0 12px;border-radius:6px;color:#4b5563;font-size:14px;text-decoration:none;transition:background-color .2s ease,color .2s ease}.ds-nav:hover{background:#f3f4f6}.ds-nav.is-current{background:var(--ah-primary,#635bff);color:#fff;font-weight:600}.ds-nav svg{flex:none;width:16px;height:16px}"
    },
    {
      "name": "Workspace Tab",
      "kind": "chip",
      "refersTo": "tab-active",
      "description": "40px 页签条里的 24px 小标签：当前页紫雾底 + 紫字。",
      "html": "<div class=\"ds-tabs\"><span class=\"ds-tab is-active\">模型管理<i class=\"ds-tab-close\">×</i></span><span class=\"ds-tab\">工具管理</span></div>",
      "css": ".ds-tabs{display:flex;align-items:center;gap:4px;height:40px;padding:0 12px;background:#f5f7fa;border-bottom:1px solid #f2f6fc;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif}.ds-tab{display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 8px;border-radius:6px;color:#6b7280;font-size:12px;line-height:1;cursor:pointer;white-space:nowrap}.ds-tab:hover{background:rgba(255,255,255,.72);color:#1f2937}.ds-tab.is-active{background:#f4f3ff;color:var(--ah-primary,#635bff);font-weight:600}.ds-tab-close{font-style:normal;font-size:11px;opacity:.55}.ds-tab-close:hover{opacity:1}"
    },
    {
      "name": "Config Card",
      "kind": "card",
      "refersTo": "card-config",
      "description": "模型 / 工具 / Skill / Agent 网格业务卡：160px 锁高、两行描述、36px 底栏。",
      "html": "<article class=\"ds-card\"><header class=\"ds-card-head\"><h3>DeepSeek 对话</h3></header><div class=\"ds-card-body\"><p>按用途绑定的对话实例，出站走统一协议适配层，失败可回落。</p></div><footer class=\"ds-card-foot\"><span>v2</span><span>3 个工具</span></footer></article>",
      "css": ".ds-card{display:flex;flex-direction:column;height:160px;min-height:160px;max-height:160px;overflow:hidden;border-radius:8px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.05);cursor:pointer;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;transition:box-shadow .2s ease,transform .2s ease}.ds-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.ds-card-head{padding:12px 14px 0;min-width:0}.ds-card-head h3{margin:0;overflow:hidden;color:#303133;font-size:14px;font-weight:600;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}.ds-card-body{flex:1 1 auto;min-height:0;overflow:hidden;padding:8px 14px}.ds-card-body p{display:-webkit-box;margin:0;overflow:hidden;color:#606266;font-size:14px;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.ds-card-foot{display:flex;align-items:center;gap:8px;height:36px;margin-top:auto;padding:0 10px;border-top:1px solid #f2f6fc;background:#fafafa;color:#6b7280;font-size:12px}"
    },
